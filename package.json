{
  "name": "@whsy/dispatcher",
  "version": "0.0.1",
  "description": "Typed request/response messaging for Web Workers",
  "scripts": {
    "dev": "webpack serve --config webpack.config.dev.js",
    "build": "rimraf ./build && webpack --config webpack.config.prod.js && tsc --project tsconfig.build.json && pnpm run copy",
    "copy": "copyfiles -f ./src/lib/package.json ./build/@whsy/dispatcher && copyfiles -f ./LICENSE ./build/@whsy/dispatcher && copyfiles -f ./README.md ./build/@whsy/dispatcher && copyfiles -f ./README-zh.md ./build/@whsy/dispatcher && copyfiles -f ./asset/logo.png ./build/@whsy/dispatcher/asset",
    "test:e2e-open": "cypress open",
    "test:e2e-headless": "cypress run",
    "test:native": "bun test",
    "doc": "typedoc --options ./typedoc.json",
    "doc:preview": "http-server ./docs",
    "publish": "pnpm publish --tag latest --access public ./build/@whsy/dispatcher"
  },
  "author": "Jack Lee",
  "email": "whimsystudio@163.com",
  "homepage": "https://github.com/WhimsyStudio/dispatcher#readme",
  "keywords": [
    "web worker",
    "typescript",
    "worker"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/WhimsyStudio/dispatcher.git"
  },
  "devDependencies": {
    "@babel/core": "^8.0.7",
    "@babel/preset-env": "^8.0.7",
    "@babel/preset-typescript": "^8.0.7",
    "@types/bun": "^1.4.4",
    "@types/jquery": "^4.0.1",
    "@types/lodash-es": "^4.17.12",
    "@typescript-eslint/eslint-plugin": "^8.72.0",
    "@typescript-eslint/parser": "^8.72.0",
    "babel-loader": "^10.1.1",
    "bun": "^1.4.4",
    "copyfiles": "^2.4.1",
    "cypress": "^16.2.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "http-server": "^14.1.1",
    "html-webpack-plugin": "^5.6.8",
    "jquery": "^4.0.0",
    "lodash-es": "^4.18.1",
    "mochawesome": "^8.1.1",
    "mochawesome-merge": "^5.1.1",
    "mochawesome-report-generator": "^6.3.2",
    "prettier": "^3.9.10",
    "rimraf": "^6.1.3",
    "terser-webpack-plugin": "^5.6.1",
    "tsconfig-paths-webpack-plugin": "^4.2.0",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "webpack": "^5.112.1",
    "webpack-cli": "^7.2.3",
    "webpack-dev-server": "^6.1.0",
    "worker-loader": "^3.0.8"
  }
}
