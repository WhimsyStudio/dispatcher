{
  "compilerOptions": {
    "rootDir": "./",
    "noImplicitAny": true,
    "outDir": "dist",
    "module": "esnext",
    "target": "es2023",
    "allowJs": true,
    "sourceMap": true,
    "declaration": true,
    "emitDeclarationOnly": true,
    "lib": ["ES2023", "DOM", "WebWorker"],
    "moduleResolution": "bundler",
    "skipLibCheck": true,
    "paths": {
      "@whsy/*": ["./src/lib/*"]
    },
    "types": ["cypress","jquery","bun"]
  },
  "include": ["src/**/*.ts", "cypress"],
  "exclude": ["node_modules"]
}
